# Copier ce fichier en .env.local puis remplir avec les valeurs de votre projet Supabase
# (Supabase > Project Settings > API). Les mêmes variables sont à saisir dans Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=votre-cle-publique

# Adresse publique du site, pour les liens envoyés par e-mail (en production seulement ;
# sur les aperçus Vercel, l'adresse de la branche est prise automatiquement).
# SITE_URL=https://le-club-by-lcs.vercel.app

# Abonnement Stripe (voir README, rubrique « Abonnement Stripe »). Secrets : jamais dans le dépôt.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SECRET_KEY=sb_secret_...
# RESEND_API_KEY=re_...
# STRIPE_LIEN_PAIEMENT=https://buy.stripe.com/test_...

# Notifications (annonces, rappel la veille des FAQ). Clés à créer une fois avec :
#   npx web-push generate-vapid-keys
# La clé publique peut être vue par les navigateurs ; la clé privée est un SECRET (jamais dans le dépôt).
# Sans elles, l'app fonctionne mais ne propose pas les notifications.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
# VAPID_PRIVATE_KEY=...
# VAPID_CONTACT=mailto:Leclub@lcsperformance.fr
# Secret de la tâche du soir (rappels FAQ) : une longue suite de caractères au hasard.
# Vercel l'envoie tout seul à /api/rappels-faq.
# CRON_SECRET=...
